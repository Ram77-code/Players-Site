NODE_ENV=development
PORT=3000
# Number of trusted reverse-proxy hops; use 0 when directly exposed.
TRUST_PROXY=0

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
FRONTEND_ORIGIN=https://players-site.players-technology77.workers.dev

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Older projects may use SUPABASE_SERVICE_ROLE_KEY instead of SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=

# Required in production. Leave both blank only for local development.
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret-key
TURNSTILE_SITE_KEY=replace-with-turnstile-site-key
# Comma-separated widget hostnames, including the production Workers hostname.
TURNSTILE_ALLOWED_HOSTNAMES=players-site.players-technology77.workers.dev,localhost,127.0.0.1

# Optional locally; required in production for shared rate limiting.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-token